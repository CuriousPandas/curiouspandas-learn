---
import Base from '../layouts/Base.astro';
import TrackCard from '../components/TrackCard.astro';
import Panda from '../components/Panda.astro';
import ExpeditionBadge from '../components/ExpeditionBadge.astro';
import { curriculum, expeditions, hours, totals } from '../lib/curriculum.ts';
import { TIERS, TRACK_GROUPS, groupOf } from '../data/tracks.ts';
import { VIDEOS } from '../data/videos.ts';
const tracks = await curriculum();
// The ways in. An expedition is the site's own answer to "where do I start":
// a route for one kind of learner. That answer used to be one text link under
// a list of 37 trails, and the only button above it assumed a beginner. Read
// from the data, so opening another expedition adds its card here.
const waysIn = (await expeditions()).filter((e) => e.status === 'ready');
if (waysIn.length < 2) throw new Error(`The home page offers expeditions as ways in, and only ${waysIn.length} is ready`);
// The recordings are the proof that the labs are real. Linked, not embedded:
// the posters are our own files, so the page still asks Google for nothing.
const lessonOf = new Map(tracks.flatMap((tr) => tr.lessons.map((l) => [l.id, l])));
const videos = VIDEOS.map((v) => {
  const lesson = lessonOf.get(v.lesson);
  if (!lesson?.entry) throw new Error(`src/data/videos.ts: "${v.lesson}" is not a ready lesson`);
  const name = v.title.replace(/, on a real cluster$/, '');
  // Two of the videos are named after their lesson; "from" then says it twice.
  const from = lesson.entry.data.title.replace(/[?.]$/, '') === name.replace(/[?.]$/, '') ? '' : ` · from ${lesson.entry.data.title}`;
  return { ...v, name, from };
});
const t = totals(tracks);
// Someone who has never written code is who this button is for. It still looks
// for a written lesson, because when Linux & the Shell went first with every lesson
// 'soon', this button linked to a page that did not exist.
const hasLesson = (t: (typeof tracks)[number]) => t.lessons.some((l) => l.status === 'ready');
const programming = tracks.find((t) => t.id === 'programming');
const startTrack = programming && hasLesson(programming) ? programming : tracks.find(hasLesson)!;
const first = startTrack.lessons.find((l) => l.status === 'ready')!;
// The hash toy is about git specifically, wherever the course happens to start,
// so it links to the first git lesson - and the build fails if that is unwritten.
const gitFirst = tracks.find((t) => t.id === 'git')?.lessons[0];
if (!gitFirst || gitFirst.status !== 'ready') throw new Error('The home page links to the first git lesson, and it is not ready');
---
<Base title="Curious Pandas">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Free forever · open source · no account</p>
        <h1>Learn tech by <span class="hl">breaking things.</span></h1>
        <p class="lede">From your first line of code to algorithms, Kubernetes, the CNCF toolbox, neural networks and how vLLM serves a language model. Every lesson is something you can poke, break and fix - right here in your browser.</p>
        <div class="cta">
          <a class="btn primary" href={first.href}>Start with {startTrack.title} →</a>
          <a class="btn" href="/playground/">Just let me play</a>
        </div>
        <p class="muted small">{t.ready} lessons ready, {t.lessons - t.ready} more being written. Nothing to install.</p>
        <p class="small already">Already write code? <a href="#ways-in">Pick a route by where you want to end up.</a></p>
      </div>
      <div class="card toy" data-hash-toy>
        <div class="toy-head"><Panda size={26} /><strong>Type anything</strong></div>
        <textarea rows="3" aria-label="Text to hash" data-in>hello, curious panda</textarea>
        <p class="muted small">This is the exact name git would give that text as a file:</p>
        <code class="hash" data-out>…</code>
        <p class="muted small">Change one letter. The whole name changes - that is how git knows what changed without reading every byte. <a href={gitFirst.href}>See it in your first commit.</a></p>
      </div>
    </div>
  </section>

  <section class="wrap ways" id="ways-in">
    <h2>Where do you want to start?</h2>
    <p class="muted">Each of these is a route across the trails for one kind of learner, in an order where nothing is used before it is taught.</p>
    <div class="grid three">
      {waysIn.map((e) => (
        <a class="way card" href={e.href} style={`--hue:${e.hue}`}>
          <ExpeditionBadge id={e.id} icon={e.icon} hue={e.hue} size={44} />
          <span class="way-txt">
            <span class="who">"{e.who}"</span>
            <strong>{e.title}</strong>
            <span class="facts">{e.steps.length} lessons · about {hours(e.minutes)}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap how">
    <div class="grid three">
      <div class="step"><span>1</span><strong>Play in the browser</strong><p>Real-hash git, a cluster that self-heals and crashes, a neural network you can watch learn, a model server you can overload.</p></div>
      <div class="step"><span>2</span><strong>Earn your stripes</strong><p>Missions, quizzes and challenges earn XP, ranks and streaks - from Explorer to Architect. Kept in your browser, nowhere else.</p></div>
      <div class="step"><span>3</span><strong>Do it for real</strong><p>Each infrastructure lesson ends with the same thing on a real cluster, using the open <a href="https://github.com/TemplateMechanics/tilt">tilt platform</a> and its graded labs.</p></div>
    </div>
  </section>

  <section class="wrap seen">
    <h2>Watch it happen on a real cluster</h2>
    <p class="muted">{videos.length} short recordings of the real labs, each from a lesson where you break the same thing yourself. <a href="/videos/">All videos →</a></p>
    <div class="grid four">
      {videos.map((v) => (
        <a class="vid card" href={`/videos/#${v.lesson.replace('/', '-')}`}>
          <img src={v.poster} alt="" width="1280" height="720" loading="lazy" decoding="async" />
          <span class="vid-txt"><strong>{v.name}</strong><span class="facts">{v.minutes} min{v.from}</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap">
    <h2>{t.tracksWord} trails</h2>
    <p class="muted">Or pick a subject. An <a href="/expeditions/">expedition</a> crosses several of these; a trail is one.</p>
    {TRACK_GROUPS.map((g) => {
      const group = tracks.filter((tr) => groupOf(tr) === g.id);
      return (
        <div class="track-group">
          <h3>{g.title}</h3>
          <p class="muted">{g.blurb}</p>
          <div class="grid three">{group.map((tr) => <TrackCard track={tr} n={tracks.indexOf(tr) + 1} />)}</div>
        </div>
      );
    })}
  </section>

  <section class="wrap tiers">
    <h2>Works on the computer you have</h2>
    <p class="lede">Free learning sites usually die on the cost of hosting a lab machine for every learner. This one never hosts compute: your browser does the work, so it costs the same for ten learners or ten million - nothing - and no lesson's points are locked behind hardware.</p>
    <div class="grid two">
      {(Object.keys(TIERS) as (keyof typeof TIERS)[]).map((k) => (
        <div class="card tier"><strong>{TIERS[k].label}</strong><p>{TIERS[k].detail}</p></div>
      ))}
    </div>
    <p><a href="/machine/">Check what your device can run →</a></p>
  </section>
</Base>

<script>
  import { hashOf } from '../lib/git/repo.ts';
  const toy = document.querySelector<HTMLElement>('[data-hash-toy]')!;
  const input = toy.querySelector<HTMLTextAreaElement>('[data-in]')!;
  const out = toy.querySelector<HTMLElement>('[data-out]')!;
  // A trailing newline, as `echo` would write it - the same bytes the
  // playground hashes, so this number matches `echo "..." | git hash-object --stdin`.
  const show = () => { out.textContent = hashOf({ type: 'blob', data: input.value + '\n' }); out.classList.remove('flash'); void out.offsetWidth; out.classList.add('flash'); };
  input.addEventListener('input', show);
  show();
</script>

<style>
  .hero { padding: 48px 0 32px; background: radial-gradient(1200px 400px at 80% -10%, var(--bamboo-soft), transparent 70%); }
  .hero-grid { display: grid; gap: 28px; align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.15fr 1fr; } }
  .hl { color: var(--bamboo); }
  .lede { font-size: 1.12rem; color: var(--ink-2); max-width: 640px; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin: 20px 0 10px; }
  .small { font-size: 0.86rem; }
  .toy { padding: 18px; }
  .toy-head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .toy textarea { width: 100%; font: 15px/1.5 var(--mono); padding: 10px; border-radius: 10px; border: 1px solid var(--line-2); background: var(--bg); color: var(--ink); resize: vertical; }
  .hash { display: block; font-size: 0.95rem; padding: 10px 12px; border-radius: 10px; background: var(--term-bg); color: var(--term-hint); word-break: break-all; }
  .hash.flash { animation: flash .4s ease-out; }
  @keyframes flash { from { color: #fff; } }
  .already { margin: 6px 0 0; color: var(--ink-2); }
  /* Arrived at by the hero's link: clear of the sticky header, which is up
     to 124px tall on a phone. Without this the heading landed under it. */
  .ways { margin-top: 8px; scroll-margin-top: 130px; }
  .ways h2, .seen h2 { margin-top: 1.2em; }
  .way { display: flex; gap: 14px; align-items: flex-start; padding: 16px; text-decoration: none; color: var(--ink); min-width: 0; }
  a.way:hover, a.vid:hover { border-color: var(--bamboo); }
  .way-txt, .vid-txt { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .way .who { font-size: 1.02rem; font-weight: 650; line-height: 1.35; }
  .way strong { font-size: 0.9rem; color: var(--bamboo); }
  .facts { font-size: 0.84rem; color: var(--muted); }
  .grid.four { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .vid { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); overflow: hidden; min-width: 0; }
  .vid img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; border-bottom: 1px solid var(--line); }
  .vid-txt { padding: 10px 14px 12px; }
  .vid strong { font-size: 0.98rem; line-height: 1.3; }
  .how { margin-top: 24px; }
  .step { padding: 4px 0; }
  .step span { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--sun-soft); color: var(--sun-text); font-weight: 800; margin-bottom: 6px; }
  .step strong { display: block; font-size: 1.05rem; }
  .step p { color: var(--ink-2); margin: 4px 0 0; }
  .tiers { margin-top: 12px; }
  .tier { padding: 14px 16px; }
  .tier p { margin: 4px 0 0; color: var(--ink-2); font-size: 0.93rem; }
</style>
