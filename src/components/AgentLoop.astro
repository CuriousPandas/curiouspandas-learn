---
// The agent loop, one model call at a time. The "model" is a scripted stand-in
// (src/lib/agents/sim.ts): no AI is called, no request leaves the page.
import '../styles/widgets.css';
import { INVOICE_TOOLS } from '../lib/agents/scenarios.ts';
---
<div class="widget card agent-loop" data-agent-loop>
  <div class="widget-head">
    <strong>An agent, one call at a time</strong>
    <span class="pill info">simulated model - no AI is called</span>
  </div>
  <div class="controls">
    <span class="muted">Tools:</span>
    {INVOICE_TOOLS.map((t) => <label><input type="checkbox" data-tool={t.name} checked /> <code>{t.name}</code></label>)}
    <label>Step limit
      <select data-limit><option value="8">8</option><option value="4">4</option><option value="2">2</option></select>
    </label>
  </div>
  <div class="controls">
    <button class="btn small primary" type="button" data-step>Step</button>
    <button class="btn small" type="button" data-run>Run to the end</button>
    <button class="btn small" type="button" data-reset>Start over</button>
  </div>
  <div class="al-grid">
    <div class="al-main">
      <ol class="al-trace" data-trace aria-live="polite" aria-label="What happened, in order"></ol>
    </div>
    <div class="al-side">
      <div class="al-ctx">
        <span class="eyebrow">What each model call had to read</span>
        <ol class="al-bars" data-bars></ol>
        <div class="stats">
          <div class="stat">model calls<b data-calls>0</b></div>
          <div class="stat">tokens read in total<b data-total>0</b></div>
        </div>
      </div>
      <div data-mission-panel></div>
    </div>
  </div>
</div>

<script>
  import { invoiceAgent } from '../lib/agents/scenarios.ts';
  import type { AgentEvent } from '../lib/agents/sim.ts';
  import { LOOP_MISSION, type LoopRun } from '../lib/agents/missions.ts';
  import { mountMission, el } from '../lib/ui.ts';

  const line = (e: AgentEvent): [string, string, string] => {
    switch (e.kind) {
      case 'user': return ['user', 'Task', e.text];
      case 'think': return ['think', 'Model decides', e.text];
      case 'call': return ['call', 'Model calls a tool', `${e.tool}("${e.arg}")`];
      case 'result': return ['result', 'Your code ran it and pasted back', e.text];
      case 'answer': return ['answer', 'Model answers', e.text];
      case 'stopped': return ['stopped', 'The loop stopped it', e.text];
      default: return ['think', e.kind, ''];
    }
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-agent-loop]')) {
    const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const state = LOOP_MISSION.setup();
    const refresh = mountMission(q('[data-mission-panel]'), LOOP_MISSION, () => state, () => {});
    let cur: LoopRun | undefined;

    const settings = () => ({
      maxSteps: Number(q<HTMLSelectElement>('[data-limit]').value),
      tools: [...root.querySelectorAll<HTMLInputElement>('[data-tool]')].filter((c) => c.checked).map((c) => c.dataset.tool!),
    });
    // Changing a setting starts a fresh run, so a run is always one configuration.
    const fresh = () => {
      const s = settings();
      cur = { agent: invoiceAgent(s), maxSteps: s.maxSteps, tools: s.tools, manualSteps: 0 };
      state.runs.push(cur);
    };
    const ensure = () => { if (!cur || cur.agent.finished) fresh(); };

    const draw = () => {
      const a = cur?.agent;
      q('[data-trace]').replaceChildren(...(a ? a.events.map((e) => {
        const [cls, who, text] = line(e);
        return el('li', { class: cls }, el('span', { class: 'al-who' }, who), el('span', { class: 'al-text' }, text));
      }) : [el('li', { class: 'muted' }, 'Press Step to make the first model call.')]));
      const ctx = a?.contextAtCall ?? [];
      const max = Math.max(1000, ...ctx);
      q('[data-bars]').replaceChildren(...ctx.map((n, i) => {
        const bar = el('span', { class: 'al-bar' }, el('i'));
        (bar.firstChild as HTMLElement).style.width = `${(n / max) * 100}%`;
        return el('li', {}, el('b', {}, `call ${i + 1}`), bar, el('span', {}, `${n.toLocaleString('en')} tokens`));
      }));
      q('[data-calls]').textContent = String(a?.calls ?? 0);
      q('[data-total]').textContent = (a?.inputTokens ?? 0).toLocaleString('en');
      q<HTMLButtonElement>('[data-step]').textContent = a && !a.finished ? 'Step' : 'Step (new run)';
      refresh();
    };

    q('[data-step]').addEventListener('click', () => { ensure(); cur!.manualSteps++; cur!.agent.step(); draw(); });
    q('[data-run]').addEventListener('click', () => { ensure(); cur!.agent.run(); draw(); });
    q('[data-reset]').addEventListener('click', () => { fresh(); draw(); });
    root.querySelectorAll('[data-tool], [data-limit]').forEach((c) => c.addEventListener('change', () => { cur = undefined; draw(); }));
    draw();
  }
</script>

<style is:global>
  /* Global, prefixed: the trace and bars are created by the script. */
  .agent-loop .controls code { font-size: 0.82rem; }
  .agent-loop .al-grid { display: grid; gap: 14px; margin-top: 12px; }
  @media (min-width: 900px) { .agent-loop .al-grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); } }
  .agent-loop .al-main, .agent-loop .al-side { min-width: 0; display: grid; gap: 12px; align-content: start; }
  .agent-loop .al-trace { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .agent-loop .al-trace li { display: grid; gap: 2px; padding: 8px 10px; border-radius: 10px; border-left: 4px solid var(--line-2); background: var(--bg); font-size: 0.9rem; }
  .agent-loop .al-who { font-size: 0.72rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); }
  .agent-loop .al-text { overflow-wrap: anywhere; }
  .agent-loop .al-trace .user { border-left-color: var(--ink-2); }
  .agent-loop .al-trace .call { border-left-color: var(--sky); background: var(--sky-soft); font-family: var(--mono); }
  .agent-loop .al-trace .result { border-left-color: var(--line-2); background: var(--bg-2); }
  .agent-loop .al-trace .answer { border-left-color: var(--bamboo); background: var(--bamboo-soft); font-weight: 600; }
  .agent-loop .al-trace .stopped { border-left-color: var(--sun); background: var(--sun-soft); font-weight: 600; }
  .agent-loop .al-ctx { border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; }
  .agent-loop .al-bars { list-style: none; margin: 8px 0; padding: 0; display: grid; gap: 4px; }
  .agent-loop .al-bars li { display: grid; grid-template-columns: 52px minmax(0, 1fr) 96px; gap: 8px; align-items: center; font-size: 0.82rem; }
  .agent-loop .al-bars b { color: var(--ink-2); }
  .agent-loop .al-bar { height: 10px; border-radius: 99px; background: var(--bg-2); border: 1px solid var(--line); overflow: hidden; }
  .agent-loop .al-bar i { display: block; height: 100%; background: var(--sky); }
</style>
