---
import '../styles/widgets.css';
interface Props { mission?: string; title?: string }
const { mission, title = 'Cluster simulator' } = Astro.props;
---
<div class="widget card kube" data-kube-sim data-mission={mission ?? ''}>
  <div class="widget-head">
    <strong>{title}</strong>
    <span class="pill info" data-clock>t = 0s</span>
    <span class="spacer"></span>
    <div class="controls">
      <button class="btn small" type="button" data-play>Pause</button>
      <button class="btn small" type="button" data-step>Step</button>
      <label>Speed <select data-speed><option value="1000">1×</option><option value="400" selected>2.5×</option><option value="150">fast</option></select></label>
      <button class="btn small" type="button" data-reset>Start over</button>
    </div>
  </div>
  <div class="kube-grid">
    <div class="kube-left">
      <div data-term></div>
      <p class="muted tip">Click any pod to describe it.</p>
    </div>
    <div class="kube-right">
      <div data-mission-panel hidden></div>
      <div class="cluster">
        <div class="eyebrow">Cluster</div>
        <div data-nodes class="nodes"></div>
        <div class="unscheduled"><div class="eyebrow">Waiting for a node</div><div data-pending class="pods"></div></div>
        <div class="legend">
          <span><i style="background:var(--bamboo)"></i>Running &amp; Ready</span>
          <span><i style="background:var(--sky)"></i>Starting</span>
          <span><i style="background:var(--sun)"></i>Pending</span>
          <span><i style="background:var(--berry)"></i>Crashing / can't pull</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { Cluster, SECONDS_PER_TICK, type Pod } from '../lib/kube/cluster.ts';
  import { kubectl } from '../lib/kube/kubectl.ts';
  import { KUBE_MISSIONS, kubeObserve, kubeWatch, type KubeState } from '../lib/missions.ts';
  import { mountTerminal, mountMission, el } from '../lib/ui.ts';

  const cls = (p: Pod) => p.status === 'Terminating' ? 'term' : p.ready ? 'ok'
    : p.status === 'Running' || p.status === 'ContainerCreating' ? 'start'
    : p.status === 'Pending' ? 'pending' : 'bad';

  for (const root of document.querySelectorAll<HTMLElement>('[data-kube-sim]')) {
    const mission = KUBE_MISSIONS[root.dataset.mission ?? ''];
    let state: KubeState;
    const fresh = () => { state = mission ? mission.setup() : { cluster: new Cluster(), history: [], seen: new Set(), deleted: new Set() }; };
    fresh();
    let refreshMission = () => {};
    const nodesBox = root.querySelector<HTMLElement>('[data-nodes]')!;
    const pendingBox = root.querySelector<HTMLElement>('[data-pending]')!;
    const clock = root.querySelector<HTMLElement>('[data-clock]')!;

    // Pods and nodes keep their elements from tick to tick. This once rebuilt
    // them all every tick, which swallowed any click whose press and release
    // straddled a tick and threw keyboard focus off a pod each time. Chromium's
    // quick test clicks slipped between ticks; WebKit's did not.
    const chips = new Map<string, HTMLButtonElement>();
    const chip = (p: Pod) => {
      let b = chips.get(p.name);
      if (!b) {
        b = el('button', { type: 'button' }, p.name.split('-')[0], el('small', {}, p.name.split('-').pop() ?? ''), el('span', { class: 'restarts' })) as HTMLButtonElement;
        b.addEventListener('click', () => term.run(`kubectl describe pod ${p.name}`));
        chips.set(p.name, b);
      }
      b.className = `pod ${cls(p)}`;
      b.title = `${p.name}\n${p.status}${p.restarts ? ` · ${p.restarts} restarts` : ''}\n${p.template.image}`;
      b.lastElementChild!.textContent = p.restarts ? `↻${p.restarts}` : '';
      return b;
    };
    // Remove what left before inserting what arrived, so a pod that stays is
    // never detached - detaching is what drops focus.
    const sync = (box: HTMLElement, want: Node[]) => {
      const keep = new Set(want);
      for (const n of [...box.childNodes]) if (!keep.has(n)) n.remove();
      want.forEach((n, i) => { if (box.childNodes[i] !== n) box.insertBefore(n, box.childNodes[i] ?? null); });
    };
    const placeholder = (text: string) => el('span', { class: 'muted empty' }, text);
    const nodeEls = new Map<string, { root: HTMLElement; usage: HTMLElement; bar: HTMLElement; pods: HTMLElement; empty: HTMLElement }>();
    const nothingWaiting = placeholder('nothing waiting');

    const draw = () => {
      const c = state.cluster;
      clock.textContent = `t = ${c.tick * SECONDS_PER_TICK}s`;
      sync(nodesBox, c.nodes.map((n) => {
        let v = nodeEls.get(n.name);
        if (!v) {
          const usage = el('span', { class: 'muted' }), bar = el('div', { class: 'cap' }, el('i')), pods = el('div', { class: 'pods' });
          v = { root: el('div', { class: 'node' }, el('div', { class: 'node-head' }, el('strong', {}, n.name), usage), bar, pods), usage, bar, pods, empty: placeholder('no pods') };
          nodeEls.set(n.name, v);
        }
        const u = c.used(n.name);
        const pct = Math.min(100, (u.cpu / n.cpu) * 100);
        v.usage.textContent = `${u.cpu}m / ${n.cpu}m CPU requested`;
        (v.bar.firstChild as HTMLElement).style.width = `${pct}%`;
        v.bar.classList.toggle('full', pct > 90);
        const pods = [...c.pods.values()].filter((p) => p.node === n.name);
        sync(v.pods, pods.length ? pods.map(chip) : [v.empty]);
        return v.root;
      }));
      const waiting = [...c.pods.values()].filter((p) => !p.node && p.status !== 'Terminating');
      sync(pendingBox, waiting.length ? waiting.map(chip) : [nothingWaiting]);
      for (const name of chips.keys()) if (!c.pods.has(name)) chips.delete(name);
      kubeWatch(state);
      refreshMission();
    };

    const term = mountTerminal(root.querySelector<HTMLElement>('[data-term]')!, {
      prompt: '$',
      greeting: mission
        ? [`Mission: ${mission.title}. Time runs on its own - watch the cluster react.`, 'Type help for every command this cluster understands.']
        : ['A two-node toy cluster. Controllers, scheduler and kubelet run every tick.', 'Try: kubectl create deployment hello --image=panda/hello:1.0 --replicas=3'],
      onCommand: (line) => {
        kubeObserve(state, line);
        const out = kubectl(state.cluster, line);
        draw();
        return out;
      },
    });
    if (mission) {
      const panel = root.querySelector<HTMLElement>('[data-mission-panel]')!;
      panel.hidden = false;
      refreshMission = mountMission(panel, mission, () => state, (cmd) => term.type(cmd));
    }

    let playing = true;
    let timer: ReturnType<typeof setInterval> | undefined;
    const speed = root.querySelector<HTMLSelectElement>('[data-speed]')!;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const schedule = () => {
      clearInterval(timer);
      // Only tick while visible: a hidden tab or a widget scrolled far away
      // should not burn the learner's battery.
      if (playing) timer = setInterval(() => { if (!document.hidden && visible) { state.cluster.step(); draw(); } }, Number(speed.value));
    };
    let visible = true;
    new IntersectionObserver((e) => { visible = e[0].isIntersecting; }).observe(root);
    playBtn.addEventListener('click', () => { playing = !playing; playBtn.textContent = playing ? 'Pause' : 'Play'; schedule(); });
    root.querySelector('[data-step]')!.addEventListener('click', () => { state.cluster.step(); draw(); });
    speed.addEventListener('change', schedule);
    root.querySelector('[data-reset]')!.addEventListener('click', () => { fresh(); term.clear(); term.print([{ text: 'Fresh cluster.', kind: 'dim' }]); draw(); });
    schedule();
    draw();
  }
</script>

<style is:global>
  /* Global, prefixed by the widget class: the pods, nodes and file lists are
     created by the script, and Astro's scoped styles never reach elements it did
     not render, so scoped rules here silently styled nothing. */
  .kube .kube-grid { display: grid; gap: 14px; }
  @media (min-width: 900px) { .kube .kube-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); } }
  .kube .kube-left, .kube .kube-right { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .kube .tip { margin: 0; font-size: 0.82rem; }
  .kube .cluster { background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; display: flex; flex-direction: column; gap: 10px; }
  .kube .nodes { display: grid; gap: 10px; }
  .kube .node { border: 1px solid var(--line-2); border-radius: 10px; padding: 8px 10px; background: var(--panel); }
  .kube .node-head { display: flex; justify-content: space-between; gap: 8px; font-size: 0.82rem; flex-wrap: wrap; }
  .kube .cap { height: 6px; border-radius: 99px; background: var(--bg-2); margin: 6px 0 8px; overflow: hidden; }
  .kube .cap i { display: block; height: 100%; background: var(--sky); transition: width .3s; }
  .kube .cap.full i { background: var(--sun); }
  .kube .pods { display: flex; flex-wrap: wrap; gap: 6px; min-height: 30px; align-items: center; }
  .kube .unscheduled { border: 1px dashed var(--line-2); border-radius: 10px; padding: 8px 10px; }
  .kube .empty { font-size: 0.8rem; }
  .kube .pods .pod { position: relative; display: inline-flex; flex-direction: column; align-items: flex-start; border: 0; border-radius: 8px; padding: 4px 9px; font: 600 11.5px/1.25 var(--mono); color: var(--chip-ink); cursor: pointer; transition: transform .1s, opacity .3s; }
  .kube .pods .pod small { font-weight: 400; opacity: .85; }
  .kube .pods .pod:hover { transform: translateY(-1px); }
  .kube .pods .pod.ok { background: var(--bamboo); color: var(--bamboo-ink); }
  .kube .pods .pod.start { background: var(--sky); }
  .kube .pods .pod.pending { background: transparent; color: var(--sun-text); outline: 2px dashed var(--sun); }
  .kube .pods .pod.pending small { opacity: 1; }
  .kube .pods .pod.bad { background: var(--berry); animation: shake .5s; }
  .kube .pods .pod.term { background: var(--muted); opacity: .45; }
  .kube .pods .restarts { position: absolute; top: -7px; right: -7px; background: var(--ink); color: var(--bg); border-radius: 99px; font-size: 10px; padding: 1px 5px; }
  .kube .pods .restarts:empty { display: none; }
  @keyframes shake { 25% { transform: translateX(-2px); } 75% { transform: translateX(2px); } }
</style>
