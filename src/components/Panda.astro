---
// The mark: a panda face drawn from circles, so it scales to a favicon. The
// colours are fixed - a panda is black and white in dark mode too, and
// currentColor would turn its patches pale on a white face.
interface Props { size?: number; class?: string }
const { size = 32, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <circle cx="15" cy="15" r="10" fill="#18191d" />
  <circle cx="49" cy="15" r="10" fill="#18191d" />
  <circle cx="32" cy="35" r="24" fill="#fff" stroke="#18191d" stroke-width="3" />
  <ellipse cx="22.5" cy="33" rx="6.5" ry="8.5" transform="rotate(-25 22.5 33)" fill="#18191d" />
  <ellipse cx="41.5" cy="33" rx="6.5" ry="8.5" transform="rotate(25 41.5 33)" fill="#18191d" />
  <circle cx="23.5" cy="32" r="2.4" fill="#fff" />
  <circle cx="40.5" cy="32" r="2.4" fill="#fff" />
  <ellipse cx="32" cy="44" rx="4" ry="3" fill="#18191d" />
  <path d="M28 49 q4 3 8 0" fill="none" stroke="#18191d" stroke-width="2" stroke-linecap="round" />
</svg>
