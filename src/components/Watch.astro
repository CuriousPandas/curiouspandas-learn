---
// A YouTube video that loads nothing from Google until the learner presses
// play. The site promises no third-party requests (scripts/check-site.mjs
// fails a page that makes one), so the poster is our own image from public/
// and the player is swapped in on click. Streamed from YouTube rather than a
// file here so a play counts for the channel. youtube-nocookie.com is the
// privacy-enhanced embed: no viewing history is stored unless they play it.
// A wrong id or a missing poster fails the build; an empty frame would pass
// every other check and read as a broken video.
// Which video comes from src/data/videos.ts by lesson, not from attributes
// here: /videos/ shows the same list, and an id written in two places is two
// places to forget on a re-upload.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { videoFor } from '../data/videos.ts';
interface Props { lesson: string }
const { lesson } = Astro.props;
// In a lesson, the tag must name the lesson it sits in. A tag copied from
// another lesson would build, play, and show that other lesson's video.
const here = Astro.url.pathname.match(/^\/learn\/([^/]+\/[^/]+)\/?$/)?.[1];
if (here && here !== lesson) throw new Error(`<Watch lesson="${lesson}"> is in lesson ${here}; a lesson can only embed its own video`);
const { youtube, title, poster, minutes } = videoFor(lesson);
if (!/^[\w-]{11}$/.test(youtube)) throw new Error(`<Watch> youtube="${youtube}" is not a YouTube video id`);
// From the project root, not import.meta.url: at build time this code runs
// from a bundled chunk under dist/, where ../../public is nothing.
if (!poster.startsWith('/') || !existsSync(join(process.cwd(), 'public', poster))) {
  throw new Error(`<Watch> poster="${poster}" is not a file under public/`);
}
const watchUrl = `https://www.youtube.com/watch?v=${youtube}`;
const embed = `https://www.youtube-nocookie.com/embed/${youtube}?autoplay=1&rel=0`;
---
<!-- The accessible name of the play button starts with the words on it. With
     "Play video: ..." axe failed the page (label-content-name-mismatch): a
     voice-control user who says what they see, "Play 2 min", matched nothing.
     data-video, not data-watch: StranglerLab already uses data-watch for its
     watch-window text, and the site checker keys on this attribute. -->
<figure class="watch card" data-video={youtube} data-embed={embed} data-title={title}>
  <div class="w-frame">
    <img src={poster} alt="" width="1280" height="720" loading="lazy" />
    <button class="w-play" type="button" aria-label={`Play · ${minutes} min: ${title}`}><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>Play · {minutes} min</button>
  </div>
  <figcaption>
    <div class="w-head"><strong>Watch: {title}</strong><span class="pill">{minutes} min</span></div>
    <span class="muted small">Plays from YouTube when you press play; nothing loads from Google before that. <a href={watchUrl}>Open on YouTube</a></span>
  </figcaption>
</figure>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-video]')) {
    const frame = root.querySelector<HTMLElement>('.w-frame')!;
    root.querySelector('.w-play')!.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = root.dataset.embed!;
      f.title = root.dataset.title!;
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.setAttribute('allowfullscreen', '');
      frame.replaceChildren(f);
    }, { once: true });
  }
</script>
<style>
  .watch { margin: 36px 0; padding: 0; overflow: hidden; }
  .w-frame { position: relative; aspect-ratio: 16 / 9; background: #111215; }
  .w-frame img, .w-frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; object-fit: cover; }
  /* Bottom right, not centred: the poster is the episode's title card and a
     centred button sat on top of the title. */
  .w-play { position: absolute; right: 5%; bottom: 9%; padding: 10px 22px 10px 16px; border-radius: 999px; font: 600 1.05rem var(--sans);
    border: 0; background: var(--bamboo); color: var(--bamboo-ink); cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
    box-shadow: 0 6px 24px rgb(0 0 0 / 40%); }
  .w-play:hover { filter: brightness(1.08); }
  .w-play:focus-visible { outline: 3px solid var(--sun); outline-offset: 3px; }
  figcaption { display: grid; gap: 4px; padding: 12px 16px 14px; }
  .w-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .small { font-size: 0.82rem; }
</style>
