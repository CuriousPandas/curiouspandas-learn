---
// A visual guide: boxes, arrows and an optional step-through. Drawn at build
// time from data, so it follows the theme, needs no image files and fails the
// build when it is wrong (src/lib/diagram.ts). Without JavaScript the whole
// picture shows with every caption listed; with it, Back/Next reveal it in order.
import { validate, transpose, grid, size, origin, line, firstShown, edgeId, BOX, NARROW_GAP_X, type DNode, type DEdge, type DStep } from '../lib/diagram.ts';

interface Props { id: string; title: string; desc: string; nodes: DNode[]; edges?: DEdge[]; steps?: DStep[] }
const { id, title, desc, nodes, edges = [], steps = [] } = Astro.props;
validate({ id, title, desc, nodes, edges, steps });

// Phones get the short side running across. If it already does, one drawing serves both.
const narrow = grid(nodes).cols <= 2 ? nodes : transpose(nodes);
const layouts = narrow === nodes ? [{ name: 'both', nodes, gx: NARROW_GAP_X }] : [{ name: 'wide', nodes, gx: BOX.gapX }, { name: 'narrow', nodes: narrow, gx: NARROW_GAP_X }];
const at = firstShown({ id, title, desc, nodes, edges, steps });
// Rough width of an arrow label at 12.5px semibold, for the pill behind it.
const labelW = (t: string) => t.length * 7.2 + 16;
// The card hugs its picture, up to the full lesson width. A fixed 820px cap
// drew four-across diagrams' arrow labels at about 9.5px.
const widest = Math.max(...layouts.map((L) => size(L.nodes, L.gx).w));
const STRIPE = 5;
---
<figure class="diagram card" data-diagram={id} data-steps={steps.length} style={`max-width:${widest + 56}px`}>
  <figcaption class="d-head"><span class="eyebrow">Visual guide</span><strong>{title}</strong></figcaption>
  <div class="d-canvas">
    {layouts.map((L) => {
      const m = new Map(L.nodes.map((n) => [n.id, n]));
      const s = size(L.nodes, L.gx);
      const key = `${id}-${L.name}`;
      return (
        <svg class={`d-svg d-${L.name}`} viewBox={`0 0 ${s.w} ${s.h}`} style={`max-width:${s.w}px`} role="img" aria-labelledby={`${key}-t ${key}-d`}>
          <title id={`${key}-t`}>{title}</title>
          <desc id={`${key}-d`}>{desc}</desc>
          <defs>
            <marker id={`${key}-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
              <path d="M1,1 L9,5 L1,9 Z" class="d-tip" />
            </marker>
            {L.nodes.map((n) => { const o = origin(n, L.gx); return <clipPath id={`${key}-clip-${n.id}`}><rect x={o.x} y={o.y} width={BOX.w} height={BOX.h} rx="12" /></clipPath>; })}
          </defs>
          {edges.map((e) => {
            const l = line(m.get(e.from)!, m.get(e.to)!, L.gx);
            // A path rather than a line: pathLength on a path works in every
            // engine, and the draw-in animation depends on it. Dashed arrows go
            // without: dashes measured against length 1 shrank to nothing on
            // short arrows and they drew solid.
            return (
              <g class={`d-edge${e.dashed ? ' dashed' : ''}`} data-el={edgeId(e)} data-at={at.get(edgeId(e))}>
                <path d={`M${l.x1},${l.y1} L${l.x2},${l.y2}`} pathLength={e.dashed ? undefined : '1'} marker-end={`url(#${key}-arrow)`} />
              </g>
            );
          })}
          {L.nodes.map((n) => {
            const o = origin(n, L.gx);
            const cx = o.x + STRIPE / 2 + BOX.w / 2;
            return (
              <g class={`d-node k-${n.kind ?? 'plain'}`} data-el={n.id} data-at={at.get(n.id)}>
                <rect class="d-box" x={o.x} y={o.y} width={BOX.w} height={BOX.h} rx="12" />
                <rect class="d-stripe" x={o.x} y={o.y} width={STRIPE} height={BOX.h} clip-path={`url(#${key}-clip-${n.id})`} />
                <rect class="d-ring" x={o.x - 4} y={o.y - 4} width={BOX.w + 8} height={BOX.h + 8} rx="15" />
                <text class="d-label" x={cx} y={o.y + (n.sub ? 25 : 35)}>{n.label}</text>
                {n.sub && <text class="d-sub" x={cx} y={o.y + 44}>{n.sub}</text>}
              </g>
            );
          })}
          {edges.filter((e) => e.label).map((e) => {
            const l = line(m.get(e.from)!, m.get(e.to)!, L.gx);
            return (
              <g class="d-elabel" data-el={edgeId(e)} data-at={at.get(edgeId(e))}>
                <rect x={l.mx - labelW(e.label!) / 2} y={l.my - 11} width={labelW(e.label!)} height="22" rx="11" />
                <text x={l.mx} y={l.my + 4.5}>{e.label}</text>
              </g>
            );
          })}
        </svg>
      );
    })}
  </div>
  {steps.length > 0 && (
    <div class="d-steps">
      <ol class="d-captions" aria-live="polite">
        {steps.map((s, i) => <li data-i={i} data-focus={(s.focus ?? []).join(' ')}><span class="d-num" aria-hidden="true">{i + 1}</span><span>{s.caption}</span></li>)}
      </ol>
      <div class="d-nav" hidden>
        <button type="button" class="btn small" data-prev>Back</button>
        <div class="d-dots">
          {steps.map((_, i) => <button type="button" class="d-dot" data-goto={i} aria-label={`Step ${i + 1}`}></button>)}
          <span class="d-count" data-count></span>
        </div>
        <button type="button" class="btn small primary" data-next>Next</button>
      </div>
    </div>
  )}
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-diagram]')) {
    const total = Number(root.dataset.steps);
    if (!total) continue;
    const caps = [...root.querySelectorAll<HTMLElement>('.d-captions li')];
    const els = [...root.querySelectorAll<SVGGElement>('[data-at]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-goto]')];
    const nav = root.querySelector<HTMLElement>('.d-nav')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    let i = -1;
    const go = (k: number) => {
      const from = i;
      i = Math.max(0, Math.min(total - 1, k));
      root.dataset.step = String(i);
      const focus = new Set((caps[i].dataset.focus ?? '').split(' ').filter(Boolean));
      caps.forEach((c, j) => { c.hidden = j !== i; });
      for (const e of els) {
        const shownAt = Number(e.dataset.at);
        e.classList.toggle('d-off', shownAt > i);
        e.classList.toggle('d-focus', focus.has(e.dataset.el!));
        // Animate only what this step adds, and only going forward: stepping
        // back should not replay entrances the learner has already seen.
        e.classList.remove('d-enter');
        if (i > from && shownAt > from && shownAt <= i && from >= 0) { void e.getBoundingClientRect(); e.classList.add('d-enter'); }
      }
      dots.forEach((d, j) => { d.classList.toggle('done', j < i); if (j === i) d.setAttribute('aria-current', 'step'); else d.removeAttribute('aria-current'); });
      count.textContent = `${i + 1} of ${total}`;
      prev.disabled = i === 0;
      next.disabled = i === total - 1;
    };
    prev.addEventListener('click', () => go(i - 1));
    next.addEventListener('click', () => go(i + 1));
    dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.goto))));
    nav.hidden = false;
    root.classList.add('stepping');
    go(0);
  }
</script>

<style>
  .diagram { margin: 32px 0; padding: 18px; }
  .d-head { display: flex; flex-direction: column; gap: 2px; margin-bottom: 12px; }
  .d-head strong { font-size: 1.05rem; }
  /* A faint dot grid: reads as a whiteboard, and gives the boxes something to sit on. */
  .d-canvas { padding: 14px 10px; border-radius: 12px; background-color: var(--bg); background-image: radial-gradient(circle, var(--line-2) 1px, transparent 1.3px); background-size: 18px 18px; border: 1px solid var(--line); }
  .d-svg { display: block; width: 100%; height: auto; margin: 0 auto; overflow: visible; }
  .d-narrow { display: none; }
  @media (max-width: 640px) {
    .d-wide { display: none; } .d-narrow { display: block; }
    .diagram { padding: 12px 8px; }
    .d-canvas { padding: 8px 2px; }
  }

  .d-box { fill: var(--panel); stroke: var(--line-2); stroke-width: 1.3; filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 12%)) drop-shadow(0 4px 10px rgb(0 0 0 / 6%)); }
  .d-stripe { fill: var(--line-2); }
  .k-ok .d-box { fill: var(--bamboo-soft); stroke: color-mix(in srgb, var(--bamboo) 55%, transparent); } .k-ok .d-stripe { fill: var(--bamboo); }
  .k-warn .d-box { fill: var(--sun-soft); stroke: color-mix(in srgb, var(--sun) 60%, transparent); } .k-warn .d-stripe { fill: var(--sun); }
  .k-bad .d-box { fill: var(--berry-soft); stroke: color-mix(in srgb, var(--berry) 55%, transparent); } .k-bad .d-stripe { fill: var(--berry); }
  .k-info .d-box { fill: var(--sky-soft); stroke: color-mix(in srgb, var(--sky) 55%, transparent); } .k-info .d-stripe { fill: var(--sky); }
  .d-ring { fill: none; stroke: none; }
  .d-node text { text-anchor: middle; fill: var(--ink); }
  .d-label { font: 650 16px var(--sans); letter-spacing: -0.005em; }
  .d-sub { font: 12px var(--mono); fill: var(--ink-2) !important; }
  .d-edge path { fill: none; stroke: var(--muted); stroke-width: 1.7; stroke-linecap: round; }
  .d-edge.dashed path { stroke-dasharray: 6 5; }
  .d-tip { fill: var(--muted); stroke: var(--muted); stroke-width: 1; stroke-linejoin: round; }
  .d-elabel rect { fill: var(--panel); stroke: var(--line-2); }
  .d-elabel text { font: 600 12.5px var(--sans); fill: var(--ink-2); text-anchor: middle; }

  /* Steps. Hidden elements keep their space, so nothing jumps as they appear. */
  .d-off { visibility: hidden; }
  .d-node.d-focus .d-ring { stroke: var(--sun); stroke-width: 2.5; filter: drop-shadow(0 0 6px color-mix(in srgb, var(--sun) 55%, transparent)); }
  .d-edge.d-focus path { stroke: var(--sun-text); stroke-width: 2.6; }
  .d-elabel.d-focus rect { stroke: var(--sun); stroke-width: 1.6; }
  .d-elabel.d-focus text { fill: var(--sun-text); }

  .d-enter { animation: d-in .38s cubic-bezier(.2, .8, .2, 1) both; transform-box: fill-box; transform-origin: center; }
  .d-edge.d-enter:not(.dashed) path { stroke-dasharray: 1; animation: d-draw .5s ease-out both; }
  .d-edge.d-enter:not(.dashed) { animation: none; }
  @keyframes d-in { from { opacity: 0; transform: translateY(6px) scale(.97); } }
  @keyframes d-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .d-enter, .d-enter path { animation: none !important; } }

  .d-steps { margin-top: 14px; }
  .d-captions { margin: 0; padding-left: 0; list-style: none; display: grid; gap: 8px; font-size: 0.97rem; }
  .d-captions li { display: flex; gap: 10px; align-items: flex-start; }
  .d-num { flex: none; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; font: 700 0.78rem var(--sans); background: var(--sun-soft); color: var(--sun-text); border: 1px solid color-mix(in srgb, var(--sun) 50%, transparent); margin-top: 1px; }
  .stepping .d-captions { padding: 12px 14px; min-height: 3.6em; background: var(--bg-2); border-radius: 12px; }
  .d-nav { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 12px; }
  .d-dots { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; justify-content: center; }
  .d-dot { width: 10px; height: 10px; padding: 0; border-radius: 50%; border: 1.5px solid var(--line-2); background: var(--panel); cursor: pointer; transition: transform .15s, background .15s; }
  /* A dot is a small target; the invisible outline makes it 24px to tap. */
  .d-dot { outline: 7px solid transparent; outline-offset: 0; }
  .d-dot:focus-visible { outline: 3px solid var(--sky); outline-offset: 2px; }
  .d-dot.done { background: var(--bamboo); border-color: var(--bamboo); }
  .d-dot[aria-current] { background: var(--sun); border-color: var(--sun); transform: scale(1.3); }
  .d-count { font-size: 0.82rem; color: var(--muted); margin-left: 6px; font-variant-numeric: tabular-nums; }
</style>
