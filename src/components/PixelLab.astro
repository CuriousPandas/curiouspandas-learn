---
import '../styles/widgets.css';
---
<div class="widget card pixellab" data-pixellab>
  <div class="widget-head">
    <strong>Pixel Lab</strong>
    <span class="pill info">Raw bytes only, with no file header and no compression. Real image files add both</span>
  </div>
  <div class="px-grid">
    <div class="px-main">
      <div class="px-view">
        <canvas data-canvas width="8" height="8" role="img" aria-label="The bytes drawn as a picture, with the settings on this panel"></canvas>
        <div class="px-side">
          <div class="controls px-settings">
            <label>Width in pixels <input type="number" data-width min="1" max="24" step="1" value="8" /></label>
            <label>Bytes per pixel
              <select data-channels><option value="3">3: red, green, blue</option><option value="1">1: grey</option></select>
            </label>
            <label>Skip bytes
              <select data-offset><option value="0">0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option></select>
            </label>
          </div>
          <p class="px-status" data-status role="status"></p>
        </div>
      </div>
      <div class="controls">
        <label>Paint
          <select data-colour>
            <option value="255,0,0">Red</option>
            <option value="0,255,0">Green</option>
            <option value="0,0,255">Blue</option>
            <option value="20,20,20">Black</option>
            <option value="245,245,245">White</option>
          </select>
        </label>
        <label>row <select data-row>{Array.from({ length: 8 }, (_, i) => <option value={i}>{i}</option>)}</select></label>
        <label>column <select data-col>{Array.from({ length: 8 }, (_, i) => <option value={i}>{i}</option>)}</select></label>
        <button class="btn small" type="button" data-paint>Paint it</button>
        <span class="muted px-tip">or press the picture</span>
      </div>
      <p class="px-at" data-at></p>
      <details class="px-details" data-details>
        <summary><span data-total></span></summary>
        <pre class="px-bytes" data-bytes tabindex="0"></pre>
      </details>
    </div>
    <div data-mission-panel></div>
  </div>
</div>

<script>
  import { PICTURE_MISSION, PICTURE_WIDTH, applySettings, describePicture, hex2, layout, paint, type PictureChange } from '../lib/cs/bytes.ts';
  import { mountMission } from '../lib/ui.ts';

  for (const root of document.querySelectorAll<HTMLElement>('[data-pixellab]')) {
    const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const state = PICTURE_MISSION.setup();
    const refresh = mountMission(q('[data-mission-panel]'), PICTURE_MISSION, () => state);
    const canvas = q<HTMLCanvasElement>('[data-canvas]'), status = q('[data-status]'), at = q('[data-at]');
    const width = q<HTMLInputElement>('[data-width]'), channels = q<HTMLSelectElement>('[data-channels]'), offset = q<HTMLSelectElement>('[data-offset]');
    const rowSel = q<HTMLSelectElement>('[data-row]'), colSel = q<HTMLSelectElement>('[data-col]'), colour = q<HTMLSelectElement>('[data-colour]');

    const isRight = () => state.width === PICTURE_WIDTH && state.channels === 3 && state.offset === 0;

    function draw(change: PictureChange = 'none') {
      const g = layout(state.bytes, state.width, state.channels, state.offset);
      const h = g.rows.length;
      canvas.width = state.width;
      canvas.height = Math.max(h, 1);
      // Set from the shape so the pixels stay square: a stretched panda would hide what a wrong width does.
      canvas.style.aspectRatio = `${state.width} / ${Math.max(h, 1)}`;
      const ctx = canvas.getContext('2d')!;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      g.rows.forEach((row, y) => row.forEach((p, x) => {
        ctx.fillStyle = `rgb(${p[0]},${p[1]},${p[2]})`;
        ctx.fillRect(x, y, 1, 1);
      }));
      status.textContent = describePicture(state, change);
      status.className = `px-status ${isRight() ? 'ok' : 'warn'}`;
      q('[data-total]').textContent = `All ${state.bytes.length} bytes, in hex`;
      const lines: string[] = [];
      for (let i = 0; i < state.bytes.length; i += 24) lines.push(state.bytes.slice(i, i + 24).map(hex2).join(' '));
      q('[data-bytes]').textContent = lines.join('\n');
      const row = Number(rowSel.value), col = Number(colSel.value);
      if (isRight()) {
        const i = (row * state.width + col) * 3;
        at.textContent = `Row ${row}, column ${col} starts at byte ${i} (${row} × ${state.width} + ${col}, × 3): ${state.bytes.slice(i, i + 3).map(hex2).join(' ')}.`;
      } else at.textContent = 'Put the settings right to paint: the same press would change bytes that belong to some other pixel.';
      refresh();
    }

    function settings() {
      const error = applySettings(state, Number(width.value), Number(channels.value) as 1 | 3, Number(offset.value));
      if (error) {
        status.textContent = error;
        status.className = 'px-status warn';
        return;
      }
      draw('settings');
    }
    width.addEventListener('input', settings);
    channels.addEventListener('change', settings);
    offset.addEventListener('change', settings);

    const paintAt = (r: number, c: number) => {
      rowSel.value = String(r);
      colSel.value = String(c);
      draw(paint(state, r, c, colour.value.split(',').map(Number)) ? 'painted' : 'refused');
    };
    q('[data-paint]').addEventListener('click', () => paintAt(Number(rowSel.value), Number(colSel.value)));
    // Passed through a closure: a listener's event argument would otherwise arrive as `change`.
    rowSel.addEventListener('change', () => draw());
    colSel.addEventListener('change', () => draw());
    canvas.addEventListener('click', (e) => {
      const box = canvas.getBoundingClientRect();
      const c = Math.floor(((e.clientX - box.left) / box.width) * canvas.width), r = Math.floor(((e.clientY - box.top) / box.height) * canvas.height);
      if (!isRight()) { draw('refused'); return; }
      paintAt(Math.max(0, Math.min(7, r)), Math.max(0, Math.min(7, c)));
    });

    draw();
  }
</script>

<style is:global>
  .pixellab .px-grid { display: grid; gap: 14px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1000px) { .pixellab .px-grid { grid-template-columns: minmax(0, 1fr) 280px; } }
  .pixellab .px-main { min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; align-content: start; }
  .pixellab .px-view { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-start; min-width: 0; }
  .pixellab canvas { width: min(180px, 100%); image-rendering: pixelated; border: 1px solid var(--line-2); border-radius: 6px; cursor: crosshair; background: var(--bg-2); }
  .pixellab .px-side { flex: 1 1 200px; min-width: 0; display: grid; gap: 8px; }
  .pixellab .px-settings { flex-direction: column; align-items: flex-start; gap: 6px; }
  .pixellab .px-settings input[type="number"] { width: 5em; }
  .pixellab .px-status { margin: 0; font-size: 0.9rem; padding: 8px 10px; border-radius: 8px; background: var(--bg-2); overflow-wrap: anywhere; }
  .pixellab .px-status.ok { background: var(--bamboo-soft); color: var(--bamboo); }
  .pixellab .px-status.warn { background: var(--sun-soft); color: var(--sun-text); }
  .pixellab .px-at { margin: 0; font-size: 0.88rem; overflow-wrap: anywhere; }
  .pixellab .px-tip { font-size: 0.82rem; }
  .pixellab .px-details summary { cursor: pointer; font-size: 0.88rem; }
  .pixellab .px-bytes { margin: 6px 0 0; max-height: 170px; overflow: auto; background: var(--term-bg); color: var(--term-ink); border-radius: 8px; padding: 8px 10px; font: 0.72rem/1.5 var(--mono); }
</style>
