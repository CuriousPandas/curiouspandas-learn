---
// The formal version of a lesson's idea, for readers who want it. Closed by
// default and never required: lessons assume school algebra, nothing later may
// depend on what is in here, and no quiz may ask about it.
interface Props { title: string }
const { title } = Astro.props;
---
<details class="deeper">
  <summary><span class="eyebrow">Go deeper</span> {title} <span class="muted">optional: the formal version</span></summary>
  <div class="deeper-body"><slot /></div>
</details>
<style>
  .deeper { margin: 22px 0; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-2); }
  .deeper summary { cursor: pointer; padding: 10px 14px; font-weight: 600; }
  .deeper summary .muted { font-weight: 400; font-size: 0.86rem; }
  .deeper-body { padding: 0 16px 8px; }
  .deeper-body :global(p:first-child) { margin-top: 0; }
</style>
